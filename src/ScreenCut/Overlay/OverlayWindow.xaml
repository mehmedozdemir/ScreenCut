<Window x:Class="ScreenCut.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:ScreenCut.Overlay"
        Title="ScreenCut"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BarBackground" Color="#F2202124" />
        <SolidColorBrush x:Key="BarForeground" Color="#FFEDEDED" />
        <SolidColorBrush x:Key="Accent" Color="#FF2D7FF9" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="6" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF4A92FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F66D1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#552D7FF9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchToggle" TargetType="RadioButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="34" />
            <Setter Property="GroupName" Value="Color" />
        </Style>

        <Style x:Key="Swatch" TargetType="Ellipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="#88FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stroke" Value="{StaticResource BarForeground}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <Style x:Key="BarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Fill" Value="#33FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Surface: one unit = one physical pixel (scaled by 1/DPI), so the screenshot is shown 1:1. -->
        <Canvas x:Name="Surface"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                ClipToBounds="True"
                Cursor="Cross"
                MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown"
                MouseMove="OnSurfaceMouseMove"
                MouseLeftButtonUp="OnSurfaceMouseLeftButtonUp"
                MouseRightButtonUp="OnSurfaceMouseRightButtonUp"
                LostMouseCapture="OnSurfaceLostMouseCapture">
            <Canvas.LayoutTransform>
                <ScaleTransform x:Name="SurfaceScale" />
            </Canvas.LayoutTransform>

            <Image x:Name="ScreenImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <overlay:AnnotationLayer x:Name="Annotations" />
            <Path x:Name="DimPath" Fill="#8C000000" IsHitTestVisible="False" />
            <Rectangle x:Name="SelectionBorder" Stroke="{StaticResource Accent}" IsHitTestVisible="False" Visibility="Collapsed" />
            <Canvas x:Name="HandlesCanvas" IsHitTestVisible="False" />
            <TextBox x:Name="TextEditor"
                     Visibility="Collapsed"
                     AcceptsReturn="True"
                     BorderBrush="{StaticResource Accent}"
                     Padding="0"
                     MinWidth="20" />
        </Canvas>

        <!-- Chrome: regular DIP coordinates for toolbar and labels. -->
        <Canvas x:Name="ChromeCanvas">
            <Border x:Name="SizeLabel" Background="#CC000000" CornerRadius="4" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
            </Border>

            <Border x:Name="HintBanner" Background="{StaticResource BarBackground}" CornerRadius="8" Padding="14,8" IsHitTestVisible="False">
                <TextBlock Foreground="{StaticResource BarForeground}" FontSize="13" FontFamily="Segoe UI"
                           Text="Alan seçmek için sürükleyin  ·  Pencere için tıklayın  ·  F: tüm ekran  ·  Esc: iptal" />
            </Border>

            <Border x:Name="Toolbar" Background="{StaticResource BarBackground}" CornerRadius="10" Padding="6"
                    BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <!-- Row 1: tools + undo/redo -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Select" Checked="OnToolChecked"
                                     ToolTip="Seç / taşı (V) — çift tıkla: metni düzenle" AutomationProperties.Name="Seç">
                            <Path Style="{StaticResource ToolIcon}" Data="M5,3 L5,16 L8.5,12.8 L11,18 L13,17 L10.6,11.8 L15,11.6 Z" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Rectangle" Checked="OnToolChecked"
                                     ToolTip="Dikdörtgen (R) — Shift: kare" AutomationProperties.Name="Dikdörtgen">
                            <Path Style="{StaticResource ToolIcon}" Data="M3.5,5.5 H16.5 V14.5 H3.5 Z" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Ellipse" Checked="OnToolChecked"
                                     ToolTip="Elips (E) — Shift: daire" AutomationProperties.Name="Elips">
                            <Path Style="{StaticResource ToolIcon}" Data="M3,10 A7,5.5 0 1 1 17,10 A7,5.5 0 1 1 3,10 Z" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Line" Checked="OnToolChecked"
                                     ToolTip="Çizgi (L) — Shift: 45° adım" AutomationProperties.Name="Çizgi">
                            <Path Style="{StaticResource ToolIcon}" Data="M4,16 L16,4" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Arrow" Checked="OnToolChecked"
                                     ToolTip="Ok (A) — Shift: 45° adım" AutomationProperties.Name="Ok">
                            <Path Style="{StaticResource ToolIcon}" Data="M4,16 L15,5 M8.5,4.5 H15.5 V11.5" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Pen" Checked="OnToolChecked"
                                     ToolTip="Kalem (P)" AutomationProperties.Name="Kalem">
                            <Path Style="{StaticResource ToolIcon}" Data="M4,16 L5,12 L13,4 L16,7 L8,15 Z M11.5,5.5 L14.5,8.5" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Highlighter" Checked="OnToolChecked"
                                     ToolTip="Fosforlu kalem (H)" AutomationProperties.Name="Fosforlu kalem">
                            <Path Style="{StaticResource ToolIcon}" Fill="#80FFEB3B" Data="M5,15 L9,15 L15,6 L12,4 L6,12 Z M4,17.5 H16" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Text" Checked="OnToolChecked"
                                     ToolTip="Metin (T) — Enter: bitir, Shift+Enter: yeni satır" AutomationProperties.Name="Metin">
                            <TextBlock Text="T" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource BarForeground}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Number" Checked="OnToolChecked"
                                     ToolTip="Numaralı adım (N)" AutomationProperties.Name="Numaralı adım">
                            <Grid Width="18" Height="18">
                                <Ellipse Stroke="{StaticResource BarForeground}" StrokeThickness="1.6" />
                                <TextBlock Text="1" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BarForeground}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="Pixelate" Checked="OnToolChecked"
                                     ToolTip="Bulanıklaştır / pikselleştir (B)" AutomationProperties.Name="Pikselleştir">
                            <Path Width="20" Height="20" Fill="{StaticResource BarForeground}"
                                  Data="M4,4 H8 V8 H4 Z M12,4 H16 V8 H12 Z M8,8 H12 V12 H8 Z M4,12 H8 V16 H4 Z M12,12 H16 V16 H12 Z" />
                        </RadioButton>

                        <Rectangle Style="{StaticResource BarSeparator}" />

                        <Button x:Name="UndoButton" Style="{StaticResource BarButton}" Content="&#xE7A7;" Click="OnUndoClick"
                                ToolTip="Geri al (Ctrl+Z)" AutomationProperties.Name="Geri al" />
                        <Button x:Name="RedoButton" Style="{StaticResource BarButton}" Content="&#xE7A6;" Click="OnRedoClick"
                                ToolTip="Yinele (Ctrl+Y)" AutomationProperties.Name="Yinele" />
                    </StackPanel>

                    <!-- Row 2: style + actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#E53935" Checked="OnColorChecked" ToolTip="Kırmızı" AutomationProperties.Name="Kırmızı">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#E53935" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#FB8C00" Checked="OnColorChecked" ToolTip="Turuncu" AutomationProperties.Name="Turuncu">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#FB8C00" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#FDD835" Checked="OnColorChecked" ToolTip="Sarı" AutomationProperties.Name="Sarı">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#FDD835" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#43A047" Checked="OnColorChecked" ToolTip="Yeşil" AutomationProperties.Name="Yeşil">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#43A047" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#1E88E5" Checked="OnColorChecked" ToolTip="Mavi" AutomationProperties.Name="Mavi">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#1E88E5" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#8E24AA" Checked="OnColorChecked" ToolTip="Mor" AutomationProperties.Name="Mor">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#8E24AA" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#212121" Checked="OnColorChecked" ToolTip="Siyah" AutomationProperties.Name="Siyah">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#212121" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SwatchToggle}" Tag="#FFFFFF" Checked="OnColorChecked" ToolTip="Beyaz" AutomationProperties.Name="Beyaz">
                            <Ellipse Style="{StaticResource Swatch}" Fill="#FFFFFF" />
                        </RadioButton>

                        <Rectangle Style="{StaticResource BarSeparator}" />

                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Size" Tag="0" Width="28" Checked="OnSizeChecked" ToolTip="İnce" AutomationProperties.Name="İnce">
                            <Ellipse Width="4" Height="4" Fill="{StaticResource BarForeground}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Size" Tag="1" Width="28" Checked="OnSizeChecked" ToolTip="Orta" AutomationProperties.Name="Orta">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BarForeground}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Size" Tag="2" Width="28" Checked="OnSizeChecked" ToolTip="Kalın" AutomationProperties.Name="Kalın">
                            <Ellipse Width="11" Height="11" Fill="{StaticResource BarForeground}" />
                        </RadioButton>
                        <ToggleButton x:Name="TextBackgroundToggle" Width="34" Height="34" Margin="1,0" Focusable="False" Cursor="Hand"
                                      Checked="OnTextBackgroundChanged" Unchecked="OnTextBackgroundChanged"
                                      ToolTip="Metin arka planı" AutomationProperties.Name="Metin arka planı">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                        <Border Width="20" Height="16" Background="#FFEDEDED" CornerRadius="3">
                                            <TextBlock Text="T" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#FF202124"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#552D7FF9" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource BarSeparator}" />

                        <Button Style="{StaticResource BarButton}" Content="&#xE7A8;" Click="OnReselectClick"
                                ToolTip="Yeniden seç — aynı görüntüde (Ctrl+R)" AutomationProperties.Name="Yeniden seç" />
                        <Button Style="{StaticResource BarButton}" Content="&#xE72C;" Click="OnRecaptureClick"
                                ToolTip="Ekranı yeniden yakala (F5)" AutomationProperties.Name="Yeniden yakala" />

                        <Rectangle Style="{StaticResource BarSeparator}" />

                        <Button x:Name="ShareButton" Style="{StaticResource BarButton}" Content="&#xE72D;" Click="OnShareClick"
                                ToolTip="Paylaş — Windows, WhatsApp, Teams, E-posta" AutomationProperties.Name="Paylaş" />
                        <Button Style="{StaticResource BarButton}" Content="&#xE792;" Click="OnSaveAsClick"
                                ToolTip="Farklı kaydet (Ctrl+Shift+S)" AutomationProperties.Name="Farklı kaydet" />
                        <Button Style="{StaticResource BarButton}" Content="&#xE74E;" Click="OnQuickSaveClick"
                                ToolTip="Hızlı kaydet + dosya yolunu kopyala (Ctrl+S)" AutomationProperties.Name="Hızlı kaydet" />
                        <Button Style="{StaticResource PrimaryButton}" Click="OnCopyClick" Margin="4,0,1,0"
                                ToolTip="Panoya kopyala ve kapat (Ctrl+C / Enter)" AutomationProperties.Name="Kopyala">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Foreground="White" />
                                <TextBlock Text="Kopyala" FontFamily="Segoe UI" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BarButton}" Content="&#xE711;" Click="OnCloseClick"
                                ToolTip="Kapat (Esc)" AutomationProperties.Name="Kapat" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
